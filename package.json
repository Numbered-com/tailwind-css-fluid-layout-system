{
	"name": "@numbered/tailwind-fluid-layout-system",
	"version": "1.1.0",
	"description": "A Tailwind CSS plugin to fluidify layout.",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": "./dist/index.js",
		"./grid-math": "./dist/grid-math.js"
	},
	"bin": {
		"px-to-cols": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Numbered-com/tailwind-css-fluid-layout-system.git"
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "bun test",
		"prepublishOnly": "tsc",
		"version": "perl -pi -e \"s/^## \\[Unreleased\\]/## [$npm_package_version] - $(date +%F)/\" CHANGELOG.md && git add CHANGELOG.md",
		"postversion": "git push --follow-tags",
		"patch": "npm version patch",
		"minor": "npm version minor",
		"major": "npm version major"
	},
	"peerDependencies": {
		"tailwindcss": ">=4.0.0"
	},
	"devDependencies": {
		"@types/node": "^26.6.3",
		"prettier": "^3.9.9",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2"
	}
}
